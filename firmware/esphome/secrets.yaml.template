# Secrets Template
# ================
# Copy this file to secrets.yaml and fill in your actual values.
# NEVER commit the real secrets.yaml file!

# WiFi Configuration
wifi_ssid: "YOUR_WIFI_NETWORK_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant API (generate in HA: Settings > Integrations > ESPHome)
api_encryption_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# OTA Updates Password
ota_password: "CHOOSE_A_SECURE_PASSWORD"

# MQTT (if using authentication)
mqtt_user: "mqtt_user"
mqtt_password: "mqtt_password"
